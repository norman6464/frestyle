# =========================
# データベース
# =========================
# ローカル開発はリポジトリ直下の docker-compose.yml の PostgreSQL を使う (推奨)。
#   docker compose up -d   … DB + バックエンド(Go) が起動する
# その場合の DATABASE_URL は次の 1 行でよい (コメントを外す):
# DATABASE_URL=postgres://frestyle:frestyle@localhost:5432/frestyle?sslmode=disable
#
# ここに書くのは「ホストから見た」接続先(localhost)。このファイルは backend コンテナにも
# 渡すが、コンテナから見た宛先は異なるため DATABASE_URL は compose 側でサービス名(db)に
# 上書きしている。
#
# 本番 / staging は Supabase Transaction pooler URL を使う。
# 例: postgresql://postgres.xxxxx:PASSWORD@aws-N-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# - aws-N の N は Supabase project の クラスタ番号
# - pgbouncer=true は付けない (libpq 18 で接続拒否される / host 名で backend が pgbouncer を自動判定)
# DATABASE_URL がセットされていると DB_HOST 等は無視される。
DATABASE_URL=

# 個別 設定 (DATABASE_URL 未 設定 時 の フォールバック / ローカル の docker postgres など)。
# 通常は DATABASE_URL を使うため不要。
#
# DB_SSLMODE の値:
#   - require  : 本番 / staging（Supabase 等、TLS 必須の DB につなぐ場合）
#   - disable  : ローカル docker postgres など TLS 設定 が ない DB の場合
#   未指定なら backend (config.go) の getEnvOrDefault で "require" になるので、
#   ローカル docker 利用時は明示的に DB_SSLMODE=disable に書き換えること。
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fre_style
DB_SSLMODE=disable

# 実行環境。local 以外だと gin が release モードになり、ログも Info 以上に絞られる。
#
# **local だからといって認証が緩むことは無い。** 発行者を通さない逃げ道は作らない —
# APP_ENV は未設定でも local に解決されるため、そのような逃げ道があると環境変数を
# 入れ忘れた環境がそのまま素通しで動き得る。設定が欠けていれば起動を止める。
APP_ENV=local

# ===== 認証（Bearer の ID トークン検証）=====
#
# **ローカルはこのブロックを空にしたままでよい。** docker-compose.yml が backend サービスの
# environment に既定値を与える(ローカル発行者は docker/idp/config.yaml で動く OSS の Dex)。
# 別の発行者(本番の GCIP 等)へ向けたいときだけ、ここに 3 つとも上書きする
# (1 つだけ上書きすると Dex 向けの既定値と本物の発行者向けの値が混ざり、
# 起動はしても検証が必ず失敗する)。
#
# backend は ID トークンを Authorization: Bearer ヘッダで受け取って検証するだけで、
# 認可コードの交換やクライアントシークレットの概念を持たない
# （GCIP はクライアント SDK が直接発行者とやり取りして ID トークンを得る設計のため）。
#
# **どれかが空(かつ compose の既定値も無い状態)だと backend は起動しない。** 認証の設定は
# 「揃っているか、いないか」のどちらかにしてある。中途半端に動くと、検証していないことに
# 誰も気づけない。

# トークンの iss と完全一致させる文字列。ブラウザが見る URL と同じでなければならない。
# JWKS の URL から推測しないこと（発行者を替えた瞬間に全員 401 になる）。
OIDC_ISSUER=
OIDC_JWKS_URI=

# ID トークンの aud に含まれていることを要求する値（カンマ区切り）。GCIP は aud に
# クライアント ID ではなく GCP のプロジェクト ID を入れる。Dex 等の client_id 形の発行者は
# その client_id をここに入れる（backend は client_id という概念自体を持たない）。
OIDC_AUDIENCES=

# 画像
# プロフィール画像（/profile/:userId/image/presigned-url）・本文エディタに貼る画像
# （/rich-text/images/upload-url）・ナレッジのページ画像・チケットの添付が共用する
# 1 つのバケット（Cloud Storage）。
#
# **ローカルでは空のままにする。** 空なら署名 URL を作らないスタブに落ちる（開発用）。
# 値を入れると本物の GCS を使いに行き、署名に必要なサービスアカウントを
# メタデータサーバー（169.254.169.254）から引こうとする。GCP の外では必ず i/o timeout に
# なり、起動時に log.Fatal で落ちる → compose の restart で無限に再起動し、
# health も「Connection reset by peer」になる（実際に踏んだ）。
IMAGES_BUCKET=

# フロントエンドの絶対 URL
# 例: https://frestyle.dev  /  http://localhost:5173
APP_BASE_URL=http://localhost:5173

# ===== 招待メール =====
#
# **ローカルはこのブロックを空のままでよい。** docker-compose.yml が backend に
# MAIL_PROVIDER=smtp（Mailpit へ流す）を与える。届いたメールは http://localhost:8025 で見る。
#
# 本番は Amazon SES:
#   MAIL_PROVIDER=ses
#   MAIL_FROM=FreStyle <no-reply@frestyle.dev>   … SES で検証済みの identity のアドレス
#   MAIL_SES_REGION=ap-northeast-1
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY    … ses:SendEmail だけを許した IAM ユーザーの鍵（Secret Manager 経由）
# MAIL_PROVIDER=none にすると送らない（招待リンクを発行者が手で渡す運用。ロールバックの逃げ道）。
# provider が none 以外で MAIL_FROM / APP_BASE_URL（承諾 URL の origin）が無いと起動しない。
MAIL_PROVIDER=
MAIL_FROM=
MAIL_SMTP_ADDR=
MAIL_SES_REGION=
