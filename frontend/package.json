    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@tiptap/markdown": "^3.30.2",
    "@types/react": "^19.2.17",
