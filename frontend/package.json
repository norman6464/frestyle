{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/make-app-shell.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:local": "playwright test --config=playwright.local.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "tailwind:init": "tailwindcss init -p",
    "knip": "knip",
    "md2doc": "tsx scripts/md2doc.mjs",
    "size": "pnpm run build && size-limit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "WITH_STORYBOOK_TESTS=1 vitest run --project=storybook"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/roboto": "^5.2.10",
